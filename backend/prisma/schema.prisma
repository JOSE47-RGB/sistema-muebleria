generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model acciones_sistema {
  id_accion      BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  codigo         String           @unique(map: "codigo") @db.VarChar(100)
  nombre         String           @db.VarChar(100)
  descripcion    String?          @db.VarChar(255)
  estado         Int              @default(1) @db.TinyInt
  permiso_accion permiso_accion[]
  permisos       permisos[]

  @@index([codigo], map: "idx_acciones_codigo")
}

model apartado_detalle {
  id_apartado_detalle BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  id_apartado         BigInt             @db.UnsignedBigInt
  id_variante         BigInt             @db.UnsignedBigInt
  cantidad            Int
  precio_unitario     Decimal            @db.Decimal(12, 2)
  descuento           Decimal            @default(0.00) @db.Decimal(12, 2)
  subtotal            Decimal            @db.Decimal(12, 2)
  apartados           apartados          @relation(fields: [id_apartado], references: [id_apartado], onUpdate: Restrict, map: "apartado_detalle_ibfk_1")
  producto_variantes  producto_variantes @relation(fields: [id_variante], references: [id_variante], onUpdate: Restrict, map: "apartado_detalle_ibfk_2")

  @@index([id_apartado], map: "id_apartado")
  @@index([id_variante], map: "id_variante")
}

model apartados {
  id_apartado      BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  codigo_apartado  String             @unique(map: "codigo_apartado") @db.VarChar(50)
  id_cliente       BigInt             @db.UnsignedBigInt
  id_sucursal      BigInt             @db.UnsignedBigInt
  id_usuario       BigInt             @db.UnsignedBigInt
  id_turno         BigInt             @db.UnsignedBigInt
  id_estado        BigInt             @db.UnsignedBigInt
  fecha_apartado   DateTime           @default(now()) @db.DateTime(0)
  total            Decimal            @db.Decimal(12, 2)
  enganche         Decimal            @default(0.00) @db.Decimal(12, 2)
  saldo_pendiente  Decimal            @db.Decimal(12, 2)
  fecha_limite     DateTime?          @db.Date
  observaciones    String?            @db.VarChar(255)
  apartado_detalle apartado_detalle[]
  clientes         clientes           @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict, map: "apartados_ibfk_1")
  sucursales       sucursales         @relation(fields: [id_sucursal], references: [id_sucursal], onUpdate: Restrict, map: "apartados_ibfk_2")
  usuarios         usuarios           @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "apartados_ibfk_3")
  caja_turnos      caja_turnos        @relation(fields: [id_turno], references: [id_turno], onUpdate: Restrict, map: "apartados_ibfk_4")
  estados_sistema  estados_sistema    @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "apartados_ibfk_5")
  pagos            pagos[]

  @@index([id_sucursal], map: "id_sucursal")
  @@index([id_turno], map: "id_turno")
  @@index([id_usuario], map: "id_usuario")
  @@index([id_cliente], map: "idx_apartados_cliente")
  @@index([id_estado], map: "idx_apartados_estado")
  @@index([fecha_apartado], map: "idx_apartados_fecha")
}

model auditoria_accesos {
  id_acceso     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario    BigInt?   @db.UnsignedBigInt
  email_usuario String?   @db.VarChar(150)
  evento        String    @db.VarChar(50)
  ip            String?   @db.VarChar(45)
  user_agent    String?   @db.VarChar(255)
  motivo        String?   @db.VarChar(255)
  fecha         DateTime  @default(now()) @db.DateTime(0)
  usuarios      usuarios? @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Restrict, map: "auditoria_accesos_ibfk_1")

  @@index([fecha], map: "idx_auditoria_accesos_fecha")
  @@index([id_usuario], map: "idx_auditoria_accesos_usuario")
}

model auditoria_anulaciones {
  id_anulacion              BigInt                     @id @default(autoincrement()) @db.UnsignedBigInt
  id_autorizacion           BigInt?                    @db.UnsignedBigInt
  id_usuario                BigInt                     @db.UnsignedBigInt
  tabla_afectada            String                     @db.VarChar(100)
  id_registro_afectado      BigInt                     @db.UnsignedBigInt
  codigo_referencia         String?                    @db.VarChar(100)
  motivo                    String                     @db.Text
  fecha                     DateTime                   @default(now()) @db.DateTime(0)
  autorizaciones_especiales autorizaciones_especiales? @relation(fields: [id_autorizacion], references: [id_autorizacion], onDelete: Restrict, onUpdate: Restrict, map: "auditoria_anulaciones_ibfk_1")
  usuarios                  usuarios                   @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "auditoria_anulaciones_ibfk_2")

  @@index([id_autorizacion], map: "id_autorizacion")
  @@index([id_usuario], map: "id_usuario")
  @@index([tabla_afectada, id_registro_afectado], map: "idx_anulaciones_tabla_registro")
}

model auditoria_cambios {
  id_cambio         BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  id_evento         BigInt            @db.UnsignedBigInt
  campo             String            @db.VarChar(100)
  valor_anterior    String?           @db.Text
  valor_nuevo       String?           @db.Text
  fecha             DateTime          @default(now()) @db.DateTime(0)
  auditoria_eventos auditoria_eventos @relation(fields: [id_evento], references: [id_evento], onUpdate: Restrict, map: "auditoria_cambios_ibfk_1")

  @@index([id_evento], map: "idx_auditoria_cambios_evento")
}

model auditoria_consultas {
  id_consulta         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario          BigInt   @db.UnsignedBigInt
  modulo              String   @db.VarChar(100)
  accion              String   @db.VarChar(100)
  filtros_usados      String?  @db.LongText
  cantidad_resultados Int?     @default(0)
  ip                  String?  @db.VarChar(45)
  user_agent          String?  @db.VarChar(255)
  fecha               DateTime @default(now()) @db.DateTime(0)
  usuarios            usuarios @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "auditoria_consultas_ibfk_1")

  @@index([id_usuario, fecha], map: "idx_auditoria_consultas_usuario_fecha")
}

model auditoria_documentos {
  id_auditoria_documento BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  id_documento           BigInt     @db.UnsignedBigInt
  id_usuario             BigInt     @db.UnsignedBigInt
  accion                 String     @db.VarChar(80)
  motivo                 String?    @db.VarChar(255)
  ip                     String?    @db.VarChar(45)
  fecha                  DateTime   @default(now()) @db.DateTime(0)
  documentos             documentos @relation(fields: [id_documento], references: [id_documento], onUpdate: Restrict, map: "auditoria_documentos_ibfk_1")
  usuarios               usuarios   @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "auditoria_documentos_ibfk_2")

  @@index([id_usuario], map: "id_usuario")
  @@index([id_documento], map: "idx_auditoria_documentos_documento")
}

model auditoria_errores_sistema {
  id_error     BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario   BigInt?   @db.UnsignedBigInt
  modulo       String?   @db.VarChar(100)
  codigo_error String?   @db.VarChar(80)
  mensaje      String    @db.Text
  archivo      String?   @db.VarChar(255)
  linea        Int?
  ip           String?   @db.VarChar(45)
  user_agent   String?   @db.VarChar(255)
  fecha        DateTime  @default(now()) @db.DateTime(0)
  usuarios     usuarios? @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Restrict, map: "auditoria_errores_sistema_ibfk_1")

  @@index([id_usuario], map: "id_usuario")
}

model auditoria_eventos {
  id_evento              BigInt                 @id @default(autoincrement()) @db.UnsignedBigInt
  id_tipo_evento         BigInt                 @db.UnsignedBigInt
  id_usuario             BigInt?                @db.UnsignedBigInt
  id_sesion              BigInt?                @db.UnsignedBigInt
  tabla_afectada         String?                @db.VarChar(100)
  id_registro_afectado   BigInt?                @db.UnsignedBigInt
  accion                 String                 @db.VarChar(80)
  descripcion            String?                @db.Text
  ip                     String?                @db.VarChar(45)
  user_agent             String?                @db.VarChar(255)
  ruta                   String?                @db.VarChar(255)
  metodo_http            String?                @db.VarChar(10)
  origen                 String?                @default("SISTEMA") @db.VarChar(80)
  fecha                  DateTime               @default(now()) @db.DateTime(0)
  hash_evento            String?                @db.Char(64)
  auditoria_cambios      auditoria_cambios[]
  tipos_evento_auditoria tipos_evento_auditoria @relation(fields: [id_tipo_evento], references: [id_tipo_evento], onUpdate: Restrict, map: "auditoria_eventos_ibfk_1")
  usuarios               usuarios?              @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Restrict, map: "auditoria_eventos_ibfk_2")
  sesiones_usuario       sesiones_usuario?      @relation(fields: [id_sesion], references: [id_sesion], onDelete: Restrict, onUpdate: Restrict, map: "auditoria_eventos_ibfk_3")
  auditoria_integridad   auditoria_integridad[]
  auditoria_snapshots    auditoria_snapshots[]

  @@index([id_sesion], map: "id_sesion")
  @@index([fecha], map: "idx_auditoria_eventos_fecha")
  @@index([tabla_afectada, id_registro_afectado], map: "idx_auditoria_eventos_tabla_registro")
  @@index([id_tipo_evento], map: "idx_auditoria_eventos_tipo")
  @@index([id_usuario], map: "idx_auditoria_eventos_usuario")
}

model auditoria_integridad {
  id_integridad     BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  id_evento         BigInt            @db.UnsignedBigInt
  hash_anterior     String?           @db.Char(64)
  hash_actual       String            @db.Char(64)
  fecha             DateTime          @default(now()) @db.DateTime(0)
  auditoria_eventos auditoria_eventos @relation(fields: [id_evento], references: [id_evento], onUpdate: Restrict, map: "auditoria_integridad_ibfk_1")

  @@index([id_evento], map: "id_evento")
}

model auditoria_respaldos_exportaciones {
  id_registro        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario         BigInt   @db.UnsignedBigInt
  tipo               String   @db.VarChar(80)
  modulo             String?  @db.VarChar(100)
  descripcion        String?  @db.VarChar(255)
  nombre_archivo     String?  @db.VarChar(255)
  cantidad_registros Int?     @default(0)
  ip                 String?  @db.VarChar(45)
  fecha              DateTime @default(now()) @db.DateTime(0)
  usuarios           usuarios @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "auditoria_respaldos_exportaciones_ibfk_1")

  @@index([id_usuario, fecha], map: "idx_exportaciones_usuario_fecha")
}

model auditoria_snapshots {
  id_snapshot       BigInt            @id @default(autoincrement()) @db.UnsignedBigInt
  id_evento         BigInt            @db.UnsignedBigInt
  datos_anteriores  String?           @db.LongText
  datos_nuevos      String?           @db.LongText
  fecha             DateTime          @default(now()) @db.DateTime(0)
  auditoria_eventos auditoria_eventos @relation(fields: [id_evento], references: [id_evento], onUpdate: Restrict, map: "auditoria_snapshots_ibfk_1")

  @@index([id_evento], map: "id_evento")
}

model autorizaciones_especiales {
  id_autorizacion                                                  BigInt                  @id @default(autoincrement()) @db.UnsignedBigInt
  codigo_autorizacion                                              String                  @unique(map: "codigo_autorizacion") @db.VarChar(80)
  id_usuario_solicita                                              BigInt                  @db.UnsignedBigInt
  id_usuario_autoriza                                              BigInt?                 @db.UnsignedBigInt
  modulo                                                           String                  @db.VarChar(100)
  accion                                                           String                  @db.VarChar(100)
  motivo                                                           String                  @db.Text
  estado                                                           String                  @default("PENDIENTE") @db.VarChar(50)
  fecha_solicitud                                                  DateTime                @default(now()) @db.DateTime(0)
  fecha_respuesta                                                  DateTime?               @db.DateTime(0)
  ip_solicitud                                                     String?                 @db.VarChar(45)
  auditoria_anulaciones                                            auditoria_anulaciones[]
  usuarios_autorizaciones_especiales_id_usuario_solicitaTousuarios usuarios                @relation("autorizaciones_especiales_id_usuario_solicitaTousuarios", fields: [id_usuario_solicita], references: [id_usuario], onUpdate: Restrict, map: "autorizaciones_especiales_ibfk_1")
  usuarios_autorizaciones_especiales_id_usuario_autorizaTousuarios usuarios?               @relation("autorizaciones_especiales_id_usuario_autorizaTousuarios", fields: [id_usuario_autoriza], references: [id_usuario], onDelete: Restrict, onUpdate: Restrict, map: "autorizaciones_especiales_ibfk_2")

  @@index([id_usuario_autoriza], map: "id_usuario_autoriza")
  @@index([id_usuario_solicita], map: "id_usuario_solicita")
  @@index([estado], map: "idx_autorizaciones_estado")
}

model bitacora_auditoria {
  id_bitacora    BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario     BigInt?   @db.UnsignedBigInt
  tabla_afectada String    @db.VarChar(100)
  accion         String    @db.VarChar(50)
  descripcion    String?   @db.Text
  ip             String?   @db.VarChar(45)
  user_agent     String?   @db.VarChar(255)
  fecha          DateTime  @default(now()) @db.DateTime(0)
  usuarios       usuarios? @relation(fields: [id_usuario], references: [id_usuario], onDelete: Restrict, onUpdate: Restrict, map: "bitacora_auditoria_ibfk_1")

  @@index([fecha], map: "idx_bitacora_fecha")
  @@index([id_usuario], map: "idx_bitacora_usuario")
}

model caja_movimientos {
  id_caja_movimiento      BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  id_turno                BigInt                @db.UnsignedBigInt
  id_tipo_movimiento_caja BigInt                @db.UnsignedBigInt
  id_metodo_pago          BigInt                @db.UnsignedBigInt
  monto                   Decimal               @db.Decimal(12, 2)
  referencia              String?               @db.VarChar(100)
  descripcion             String?               @db.VarChar(255)
  fecha                   DateTime              @default(now()) @db.DateTime(0)
  caja_turnos             caja_turnos           @relation(fields: [id_turno], references: [id_turno], onUpdate: Restrict, map: "caja_movimientos_ibfk_1")
  tipos_movimiento_caja   tipos_movimiento_caja @relation(fields: [id_tipo_movimiento_caja], references: [id_tipo_movimiento_caja], onUpdate: Restrict, map: "caja_movimientos_ibfk_2")
  metodos_pago            metodos_pago          @relation(fields: [id_metodo_pago], references: [id_metodo_pago], onUpdate: Restrict, map: "caja_movimientos_ibfk_3")

  @@index([id_metodo_pago], map: "id_metodo_pago")
  @@index([id_tipo_movimiento_caja], map: "id_tipo_movimiento_caja")
  @@index([fecha], map: "idx_caja_movimientos_fecha")
  @@index([id_turno], map: "idx_caja_movimientos_turno")
}

model caja_turnos {
  id_turno         BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  id_caja          BigInt             @db.UnsignedBigInt
  id_usuario       BigInt             @db.UnsignedBigInt
  id_estado        BigInt             @db.UnsignedBigInt
  fecha_apertura   DateTime           @default(now()) @db.DateTime(0)
  fecha_cierre     DateTime?          @db.DateTime(0)
  monto_inicial    Decimal            @default(0.00) @db.Decimal(12, 2)
  monto_esperado   Decimal            @default(0.00) @db.Decimal(12, 2)
  monto_cierre     Decimal?           @db.Decimal(12, 2)
  diferencia       Decimal?           @db.Decimal(12, 2)
  observaciones    String?            @db.VarChar(255)
  apartados        apartados[]
  caja_movimientos caja_movimientos[]
  cajas            cajas              @relation(fields: [id_caja], references: [id_caja], onUpdate: Restrict, map: "caja_turnos_ibfk_1")
  usuarios         usuarios           @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "caja_turnos_ibfk_2")
  estados_sistema  estados_sistema    @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "caja_turnos_ibfk_3")
  pagos            pagos[]
  ventas           ventas[]

  @@index([id_caja], map: "id_caja")
  @@index([id_estado], map: "idx_caja_turnos_estado")
  @@index([fecha_apertura], map: "idx_caja_turnos_fecha")
  @@index([id_usuario], map: "idx_caja_turnos_usuario")
}

model cajas {
  id_caja     BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  id_sucursal BigInt        @db.UnsignedBigInt
  codigo_caja String        @unique(map: "codigo_caja") @db.VarChar(40)
  nombre      String        @db.VarChar(100)
  estado      Int           @default(1) @db.TinyInt
  caja_turnos caja_turnos[]
  sucursales  sucursales    @relation(fields: [id_sucursal], references: [id_sucursal], onUpdate: Restrict, map: "cajas_ibfk_1")

  @@index([id_sucursal], map: "id_sucursal")
}

model categorias {
  id_categoria     BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  codigo_categoria String      @unique(map: "codigo_categoria") @db.VarChar(50)
  nombre           String      @db.VarChar(100)
  estado           Int         @default(1) @db.TinyInt
  productos        productos[]
}

model cliente_direcciones {
  id_direccion BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  id_cliente   BigInt    @db.UnsignedBigInt
  direccion    String    @db.VarChar(255)
  referencia   String?   @db.VarChar(255)
  es_principal Int       @default(0) @db.TinyInt
  estado       Int       @default(1) @db.TinyInt
  created_at   DateTime? @default(now()) @db.Timestamp(0)
  updated_at   DateTime? @db.Timestamp(0)
  clientes     clientes  @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict, map: "cliente_direcciones_ibfk_1")

  @@index([id_cliente], map: "idx_cliente_direcciones_cliente")
}

model cliente_estadisticas {
  id_cliente       BigInt    @id @db.UnsignedBigInt
  total_compras    Decimal   @default(0.00) @db.Decimal(12, 2)
  cantidad_compras Int       @default(0)
  ultima_compra    DateTime? @db.Date
  total_abonos     Decimal   @default(0.00) @db.Decimal(12, 2)
  cantidad_abonos  Int       @default(0)
  created_at       DateTime? @default(now()) @db.Timestamp(0)
  updated_at       DateTime? @db.Timestamp(0)
  clientes         clientes  @relation(fields: [id_cliente], references: [id_cliente], onUpdate: Restrict, map: "cliente_estadisticas_ibfk_1")
}

model clientes {
  id_cliente                   BigInt                         @id @default(autoincrement()) @db.UnsignedBigInt
  codigo_cliente               String                         @unique(map: "codigo_cliente") @db.VarChar(40)
  id_tipo_cliente              BigInt                         @db.UnsignedBigInt
  nombres                      String                         @db.VarChar(100)
  apellidos                    String?                        @db.VarChar(100)
  telefono                     String?                        @db.VarChar(20)
  nit                          String?                        @unique(map: "uk_clientes_nit") @db.VarChar(30)
  dpi                          String?                        @unique(map: "uk_clientes_dpi") @db.VarChar(20)
  direccion                    String?                        @db.VarChar(255)
  observaciones                String?                        @db.VarChar(255)
  estado                       Int                            @default(1) @db.TinyInt
  created_at                   DateTime?                      @default(now()) @db.Timestamp(0)
  updated_at                   DateTime?                      @db.Timestamp(0)
  apartados                    apartados[]
  cliente_direcciones          cliente_direcciones[]
  cliente_estadisticas         cliente_estadisticas?
  tipos_cliente                tipos_cliente                  @relation(fields: [id_tipo_cliente], references: [id_tipo_cliente], onUpdate: Restrict, map: "clientes_ibfk_1")
  documentos                   documentos[]
  historial_crediticio_cliente historial_crediticio_cliente[]
  historial_tipo_cliente       historial_tipo_cliente[]
  limites_credito_cliente      limites_credito_cliente?
  notificaciones_cobro         notificaciones_cobro[]
  referencias_cliente          referencias_cliente[]
  ventas                       ventas[]

  @@index([codigo_cliente], map: "idx_clientes_codigo")
  @@index([dpi], map: "idx_clientes_dpi")
  @@index([nit], map: "idx_clientes_nit")
  @@index([telefono], map: "idx_clientes_telefono")
  @@index([id_tipo_cliente], map: "idx_clientes_tipo")
}

model comisiones_vendedor {
  id_comision       BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  id_usuario        BigInt          @db.UnsignedBigInt
  id_venta          BigInt?         @db.UnsignedBigInt
  id_pago           BigInt?         @db.UnsignedBigInt
  id_regla_comision BigInt          @db.UnsignedBigInt
  monto_base        Decimal         @db.Decimal(12, 2)
  porcentaje        Decimal         @db.Decimal(5, 2)
  monto_comision    Decimal         @db.Decimal(12, 2)
  fecha             DateTime        @default(now()) @db.DateTime(0)
  id_estado         BigInt          @db.UnsignedBigInt
  usuarios          usuarios        @relation(fields: [id_usuario], references: [id_usuario], onUpdate: Restrict, map: "comisiones_vendedor_ibfk_1")
  ventas            ventas?         @relation(fields: [id_venta], references: [id_venta], onDelete: Restrict, onUpdate: Restrict, map: "comisiones_vendedor_ibfk_2")
  pagos             pagos?          @relation(fields: [id_pago], references: [id_pago], onDelete: Restrict, onUpdate: Restrict, map: "comisiones_vendedor_ibfk_3")
  reglas_comision   reglas_comision @relation(fields: [id_regla_comision], references: [id_regla_comision], onUpdate: Restrict, map: "comisiones_vendedor_ibfk_4")
  estados_sistema   estados_sistema @relation(fields: [id_estado], references: [id_estado], onUpdate: Restrict, map: "comisiones_vendedor_ibfk_5")

  @@index([id_estado], map: "id_estado")
  @@index([id_pago], map: "id_pago")
